{
  "scripts": {
    "create-browser-action": "node ./scripts/create-browser-action.mjs",
    "watch-options-html": "npx -y chokidar-cli options.html -c \"npm run create-browser-action\" --initial",
    "create-store-description": "node ./scripts/create-store-description.mjs",
    "check": "biome check && npm run typecheck",
    "check:fix": "biome check --write",
    "test": "npm run check && vitest run --config tests/vitest.config.mjs",
    "test:watch": "vitest --config tests/vitest.config.mjs",
    "typecheck": "npx --yes -p typescript tsc -p jsconfig.json --noEmit && npx --yes -p typescript tsc -p scripts/jsconfig.json --noEmit && npx --yes -p typescript tsc -p tests/jsconfig.json --noEmit",
    "release": "node ./scripts/release.mjs",
    "prepare-safari": "node ./scripts/prepare-safari.mjs",
    "prebuild": "npm run create-browser-action",
    "build": "node ./scripts/build.mjs",
    "build-mv2": "node ./scripts/build.mjs 2",
    "build-mv3": "node ./scripts/build.mjs 3",
    "clean": "node ./scripts/clean.mjs",
    "lint-mv2": "npm run copy-mv2 && web-ext lint && npm run clean",
    "lint-mv3": "npm run copy-mv3 && web-ext lint && npm run clean",
    "copy-mv2": "node ./scripts/copy.mjs 2",
    "copy-mv3": "node ./scripts/copy.mjs 3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/chrome": "0.2.x",
    "@types/node": "25.x",
    "clipboardy": "5.x",
    "semver": "7.x",
    "vitest": "5.x",
    "web-ext": "7.x"
  }
}
