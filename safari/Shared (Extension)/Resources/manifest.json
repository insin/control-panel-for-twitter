{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescriptionShort__",
  "homepage_url": "https://soitis.dev/control-panel-for-twitter",
  "version": "5.0.0",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://pro.soitis.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "world": "MAIN",
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pro.soitis.dev/*"
      ],
      "js": [
        "content-pro.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "extensions-pro-id.js",
        "settings.js"
      ],
      "matches": [
        "https://pro.soitis.dev/*",
        "https://twitter.com/*",
        "https://x.com/*"
      ]
    }
  ],
  "options_ui": {
    "browser_style": true,
    "page": "options.html"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "browser_action.html",
    "default_icon": {
      "16": "icons/toolbar-icon16.png",
      "19": "icons/toolbar-icon19.png",
      "32": "icons/toolbar-icon32.png",
      "38": "icons/toolbar-icon38.png",
      "48": "icons/toolbar-icon48.png",
      "72": "icons/toolbar-icon72.png"
    }
  }
}
